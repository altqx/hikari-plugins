            "description": {
              "description": "Plain text under the title.",
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "keywords": {
              "description": "More words the Settings search matches.",
              "type": "array",
              "maxItems": 16,
              "items": {"type": "string", "minLength": 1, "maxLength": 50}
            },
            "deprecated": {
              "description": "Why the setting is going; Settings hides it unless its value isn't the default, and then shows this.",
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "group": {
              "description": "Settings of one group share a heading on the plugin's page, groups in order of their first setting.",
              "$ref": "#/$defs/Title"
            },
            "order": {"type": "integer", "minimum": 0, "maximum": 9999},
            "projectable": {"description": "false: a Project can't override it.", "type": "boolean", "default": true}
