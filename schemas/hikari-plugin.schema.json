{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hikarisub.altqx.com/schemas/hikari-plugin.schema.json",
  "title": "HikariSub plugin manifest (hikari-plugin.json)",
  "type": "object",
  "required": ["id", "name", "version", "api", "authors"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "id": {
      "description": "Reverse-DNS, lowercase, at least two parts: com.example.line-tools.",
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
    },
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "version": {
      "description": "Semantic version 2.0.0.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "api": {
      "description": "The lowest Hikari API number the plugin needs.",
      "type": "integer",
      "minimum": 1
    },
    "main": {
      "description": "The plugin's code: a Lua file the helper runs, or a program from contributes.programs that speaks the plugin protocol over JSON-RPC. Without main the package runs no code of its own.",
      "oneOf": [
        {"$ref": "#/$defs/PackagePath"},
        {
          "type": "object",
          "required": ["program"],
          "additionalProperties": false,
          "properties": {"program": {"$ref": "#/$defs/LocalId"}}
        }
      ]
    },
    "tier": {
      "description": "restricted runs without ffi, io, os and debug; unrestricted needs the user's full trust.",
      "enum": ["restricted", "unrestricted"],
      "default": "restricted"
    },
    "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "description": {"type": "string", "maxLength": 1000},
    "license": {"description": "An SPDX expression.", "type": "string", "maxLength": 200},
    "homepage": {"type": "string", "maxLength": 500, "pattern": "^https://"},
    "summary": {
      "description": "One line for the marketplace's cards and the plugin page.",
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "icon": {
      "description": "A file in the package: a 256 × 256 px PNG or a square SVG.",
      "$ref": "#/$defs/IconPath"
    },
    "screenshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["path", "caption"],
        "additionalProperties": false,
        "properties": {
          "path": {"$ref": "#/$defs/ScreenshotPath"},
          "caption": {
            "description": "Shown under the image and used as its alt text.",
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
          }
        }
      }
    },
    "publicKey": {
      "description": "The author's minisign public key, the base64 line of its .pub file. Pinned at first install.",
      "type": "string",
      "pattern": "^RW[A-Za-z0-9+/]{54}$"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documents.all": {
          "description": "Read and edit every open Document, not just the active one. The value is the reason shown to the user.",
          "$ref": "#/$defs/Reason"
        },
        "network": {
          "type": "object",
          "required": ["hosts", "reason"],
          "additionalProperties": false,
          "properties": {
            "hosts": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/Host"}},
            "reason": {"$ref": "#/$defs/Reason"}
          }
        },
        "files": {
          "description": "Folders the plugin asks the user to pick; HikariSub remembers each grant.",
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["id", "title", "reason"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/LocalId"},
              "title": {"$ref": "#/$defs/Title"},
              "writable": {"type": "boolean", "default": false},
              "reason": {"$ref": "#/$defs/Reason"}
            }
          }
        },
        "vcs.read": {
          "description": "Read the branches, tags, recent commits and the active Document's earlier versions in the git repository holding it (vcs.refs, vcs.show). The value is the reason shown to the user.",
          "$ref": "#/$defs/Reason"
        },
        "programs": {
          "description": "Run the programs in contributes.programs. The value is the reason shown to the user.",
          "$ref": "#/$defs/Reason"
        },
        "background": {
          "description": "Start with HikariSub and work while no command runs, with timers. The value is the reason shown to the user.",
          "$ref": "#/$defs/Reason"
        },
        "presence": {
          "description": "Set the text that {plugin} shows in the user's Discord status (presence.set_text). The value is the reason shown to the user.",
          "$ref": "#/$defs/Reason"
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/LocalId"},
              "title": {"$ref": "#/$defs/Title"},
              "description": {
                "description": "One line for the command palette and, with aiTools, the AI.",
                "$ref": "#/$defs/Summary"
              },
              "icon": {"$ref": "#/$defs/IconRef"},
              "when": {"$ref": "#/$defs/Conditions"},
              "palette": {
                "description": "false keeps the command out of the command palette, for one only a status item, a menu or the AI runs.",
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "panels": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/LocalId"},
              "title": {"$ref": "#/$defs/Title"},
              "area": {
                "description": "Where the panel docks the first time it is shown.",
                "enum": ["left", "right", "bottom"],
                "default": "right"
              },
              "qml": {
                "description": "Full trust only: the panel is this QML file in the package instead of a widget tree.",
                "$ref": "#/$defs/QmlPath"
              },
              "icon": {"$ref": "#/$defs/IconRef"}
            }
          }
        },
        "settings": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/Setting"}},
        "nodes": {
          "description": "Lua nodes for node effects, run in the node sandbox like a Lua node.",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["id", "title", "file", "outputs"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/LocalId"},
              "title": {"$ref": "#/$defs/Title"},
              "summary": {"type": "string", "minLength": 1, "maxLength": 300},
              "file": {"description": "The node's Lua code, a file in the package.", "$ref": "#/$defs/PackagePath"},
              "inputs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/NodeInput"}},
              "outputs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/NodePort"}}
            }
          }
        },
        "themes": {
          "description": "Colour themes for Settings > Appearance, at the same level as the built-in ones; their id is plugin:<plugin id>/<id>.",
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["id", "title", "type", "path"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/LocalId"},
              "title": {"$ref": "#/$defs/Title"},
              "type": {
                "description": "The theme file's own type, repeated so the theme can be listed without reading it.",
                "enum": ["light", "dark", "highContrastLight", "highContrastDark"]
              },
              "path": {
                "description": "A theme file in the package, checked against hikari-theme.schema.json.",
                "$ref": "#/$defs/JsonPath"
              }
            }
          }
        },
        "iconThemes": {
          "description": "Icon themes that replace HikariSub's interface icons.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["id", "title", "path"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/LocalId"},
              "title": {"$ref": "#/$defs/Title"},
              "path": {
                "description": "A package folder holding <role>.svg for every icon role.",
                "$ref": "#/$defs/FolderPath"
              }
            }
          }
        },
        "icons": {
          "description": "The plugin's own icons, named own:<id> wherever an icon is asked for.",
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["id", "path"],
            "additionalProperties": false,
            "properties": {"id": {"$ref": "#/$defs/LocalId"}, "path": {"$ref": "#/$defs/SvgPath"}}
          }
        },
        "styles": {
          "description": "Style catalogues for the Style manager.",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["id", "title", "path"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/LocalId"},
              "title": {"$ref": "#/$defs/Title"},
              "path": {"$ref": "#/$defs/StylesPath"}
            }
          }
        },
        "karaokePresets": {
          "description": "Karaoke presets, shown beside the built-in ones.",
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["id", "path"],
            "additionalProperties": false,
            "properties": {"id": {"$ref": "#/$defs/LocalId"}, "path": {"$ref": "#/$defs/KaraokePresetPath"}}
          }
        },
        "graphs": {
          "description": "Node-effect graphs for the graph library.",
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["id", "title", "path"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/LocalId"},
              "title": {"$ref": "#/$defs/Title"},
              "path": {"$ref": "#/$defs/GraphPath"}
            }
          }
        },
        "snippets": {
          "description": "ASS override tag snippets for the line editor.",
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": ["id", "title", "insert"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/LocalId"},
              "title": {"$ref": "#/$defs/Title"},
              "description": {"$ref": "#/$defs/Summary"},
              "prefix": {
                "description": "What the user types for the line editor to offer the snippet, such as \\fad.",
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[^\\s{}]+$"
              },
              "insert": {
                "description": "ASS text with $1 to $9, ${1:default} and $0 stops.",
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        },
        "dictionaries": {
          "description": "Hunspell spelling dictionaries.",
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["language", "title", "aff", "dic"],
            "additionalProperties": false,
            "properties": {
              "language": {
                "description": "The Hunspell dictionary's name, such as en_US, de_DE_frami or ca_ES-valencia.",
                "type": "string",
                "pattern": "^[A-Za-z0-9]+([_-][A-Za-z0-9]+)*$",
                "maxLength": 32
              },
              "title": {"$ref": "#/$defs/Title"},
              "aff": {"$ref": "#/$defs/AffPath"},
              "dic": {"$ref": "#/$defs/DicPath"}
            }
          }
        },
        "layouts": {
          "description": "Saved layouts for Manage layouts.",
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["id", "title", "path"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/LocalId"},
              "title": {"$ref": "#/$defs/Title"},
              "path": {"$ref": "#/$defs/LayoutPath"}
            }
          }
        },
        "menus": {
          "description": "Where the plugin's commands appear besides the command palette and Automation > <plugin>.",
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["command", "location"],
            "additionalProperties": false,
            "properties": {
              "command": {"description": "A command from contributes.commands.", "$ref": "#/$defs/LocalId"},
              "location": {"$ref": "#/$defs/MenuLocation"},
              "group": {
                "description": "Items of one group sit together between separators, groups in order of first appearance.",
                "$ref": "#/$defs/LocalId"
              }
            }
          }
        },
        "statusItems": {
          "description": "Status bar items after HikariSub's own; the plugin changes them with status_items.set.",
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/LocalId"},
              "title": {
                "description": "Its name in the status bar's menu and for screen readers.",
                "$ref": "#/$defs/Title"
              },
              "text": {"$ref": "#/$defs/StatusText"},
              "icon": {"$ref": "#/$defs/IconRef"},
              "tooltip": {"$ref": "#/$defs/Summary"},
              "command": {
                "description": "A command from contributes.commands that a click runs.",
                "$ref": "#/$defs/LocalId"
              }
            },
            "anyOf": [{"required": ["text"]}, {"required": ["icon"]}]
          }
        },
        "keybindings": {
          "description": "Default shortcuts. The user's own and HikariSub's shortcuts win a conflict.",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["command", "key"],
            "additionalProperties": false,
            "properties": {
              "command": {"description": "A command from contributes.commands.", "$ref": "#/$defs/LocalId"},
              "key": {"$ref": "#/$defs/Key"}
            }
          }
        },
        "programs": {
          "description": "Outside programs that HikariSub starts in its sandbox; needs permissions.programs.",
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["id", "title", "platforms"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/LocalId"},
              "title": {"$ref": "#/$defs/Title"},
              "platforms": {"$ref": "#/$defs/ProgramPlatforms"},
              "network": {
                "description": "The program may connect to the internet.",
                "type": "boolean",
                "default": false
              },
              "api": {
                "description": "HikariSub speaks the plugin protocol, JSON-RPC on stdio, with the program.",
                "type": "boolean",
                "default": false
              },
              "confinement": {
                "description": "Windows only: container runs it in an AppContainer; lowIntegrity at low integrity, for runtimes an AppContainer stops. Low integrity always has the network, so it needs network: true, and the install question says it can read your files.",
                "enum": ["container", "lowIntegrity"],
                "default": "container"
              }
            },
            "anyOf": [
              {"properties": {"confinement": {"const": "container"}}},
              {"properties": {"network": {"const": true}}, "required": ["network"]}
            ]
          }
        },
        "languageServers": {
          "description": "Language servers HikariSub runs and talks to itself.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["id", "title", "program"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/LocalId"},
              "title": {"$ref": "#/$defs/Title"},
              "program": {
                "description": "A program from contributes.programs that speaks LSP on stdio.",
                "$ref": "#/$defs/LocalId"
              },
              "scope": {
                "description": "document: one text document per subtitle Document, one LSP line per Line; line: one per Line.",
                "enum": ["document", "line"],
                "default": "document"
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {"$ref": "#/$defs/TextField"},
                "default": ["text"]
              },
              "tags": {
                "description": "keep sends override blocks; blank turns each one, \\N and \\h into as many spaces.",
                "enum": ["keep", "blank"],
                "default": "blank"
              },
              "languageId": {
                "type": "string",
                "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
                "maxLength": 64,
                "default": "plaintext"
              },
              "initializationOptions": {"description": "Sent as is in initialize.", "type": "object"}
            }
          }
        },
        "providers": {
          "description": "Line editor features the plugin's code answers. Problems come from problems.set.",
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {
            "completion": {
              "type": "object",
              "required": [],
              "additionalProperties": false,
              "properties": {
                "triggers": {
                  "description": "Characters that ask for completions as they are typed.",
                  "type": "array",
                  "maxItems": 8,
                  "items": {"type": "string", "minLength": 1, "maxLength": 1}
                },
                "fields": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 2,
                  "items": {"$ref": "#/$defs/TextField"},
                  "default": ["text"]
                }
              }
            },
            "hover": {
              "type": "object",
              "required": [],
              "additionalProperties": false,
              "properties": {
                "fields": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 2,
                  "items": {"$ref": "#/$defs/TextField"},
                  "default": ["text"]
                }
              }
            }
          }
        },
        "aiTools": {
          "description": "Commands the AI may call as typed tools, under the usual approval.",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["command", "description", "parameters", "mark"],
            "additionalProperties": false,
            "properties": {
              "command": {
                "description": "A command from contributes.commands; the tool runs it with its arguments.",
                "$ref": "#/$defs/LocalId"
              },
              "description": {
                "description": "What the tool does, for the model.",
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "parameters": {
                "description": "A JSON Schema in the Hikari API's subset whose root is an object that refuses unknown properties.",
                "type": "object",
                "required": ["type", "additionalProperties"],
                "properties": {"type": {"const": "object"}, "additionalProperties": {"const": false}}
              },
              "result": {"description": "A JSON Schema for what the command returns.", "type": "object"},
              "mark": {
                "description": "read: the tool changes nothing, and HikariSub refuses its writes.",
                "enum": ["read", "write"]
              }
            }
          }
        },
        "mcpServers": {
          "description": "MCP servers listed in Settings > AI, off until the user turns one on.",
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "title", "program"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/LocalId"},
              "title": {"$ref": "#/$defs/Title"},
              "description": {"$ref": "#/$defs/Summary"},
              "program": {
                "description": "A program from contributes.programs that speaks MCP on stdio.",
                "$ref": "#/$defs/LocalId"
              }
            }
          }
        },
        "formats": {
          "description": "Subtitle formats the plugin reads or writes; at least one of import and export.",
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["id", "title", "extensions"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/LocalId"},
              "title": {"$ref": "#/$defs/Title"},
              "extensions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {"type": "string", "pattern": "^[a-z0-9]{1,16}$"}
              },
              "import": {"type": "boolean", "default": false},
              "export": {"type": "boolean", "default": false}
            },
            "anyOf": [
              {"properties": {"import": {"const": true}}, "required": ["import"]},
              {"properties": {"export": {"const": true}}, "required": ["export"]}
            ]
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "description": "Only Full trust plugins can ship QML panels.",
      "properties": {"tier": {"const": "unrestricted"}},
      "required": ["tier"]
    },
    {"properties": {"contributes": {"properties": {"panels": {"items": {"properties": {"qml": {"maxLength": 0}}}}}}}}
  ],
  "$defs": {
    "LocalId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64},
    "Title": {"type": "string", "minLength": 1, "maxLength": 100},
    "Reason": {"type": "string", "minLength": 1, "maxLength": 300},
    "Host": {
      "description": "A host name the plugin may reach over HTTPS; no scheme, port or wildcard.",
      "type": "string",
      "maxLength": 253,
      "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]([a-z0-9-]*[a-z0-9])?$"
    },
    "PackagePath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*\\.lua$"
    },
    "NodePort": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 64},
        "type": {"enum": ["Number", "Text", "Colour", "Alpha", "Time", "Point", "Bool", "Tags"]}
      }
    },
    "NodeInput": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 64},
        "type": {"enum": ["Number", "Text", "Colour", "Alpha", "Time", "Point", "Bool", "Tags"]},
        "default": {"description": "Its value while no wire reaches it: a number, text, #RRGGBB, [x, y] or a boolean, by its type."}
      }
    },
    "Summary": {"type": "string", "minLength": 1, "maxLength": 300},
    "FolderPath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*$"
    },
    "JsonPath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*\\.json$"
    },
    "SvgPath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*\\.svg$"
    },
    "AffPath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*\\.aff$"
    },
    "DicPath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*\\.dic$"
    },
    "IconRef": {
      "description": "One of HikariSub's icon roles, or own:<id> from contributes.icons.",
      "type": "string",
      "maxLength": 68,
      "pattern": "^(own:)?[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "Conditions": {
      "description": "All must hold for the command to be enabled; ! negates one.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string", "pattern": "^!?(document|selection|multipleLines|video|audio|karaoke|translation)$"}
    },
    "MenuLocation": {"enum": ["grid.context", "lineEditor.context", "menuBar"]},
    "StatusText": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
    "Key": {
      "description": "One chord in Qt's portable text, modifiers in the order Ctrl, Alt, Shift, Meta. Without Ctrl or Alt it must be F1 to F24.",
      "type": "string",
      "pattern": "^(Ctrl\\+(Alt\\+)?|Alt\\+)(Shift\\+)?(Meta\\+)?([A-Z0-9]|F([1-9]|1[0-9]|2[0-4])|Space|Tab|Return|Enter|Backspace|Del|Ins|Home|End|PgUp|PgDown|Left|Right|Up|Down|[-=\\[\\];',./`\\\\])$|^(Shift\\+)?(Meta\\+)?F([1-9]|1[0-9]|2[0-4])$"
    },
    "TextField": {"enum": ["text", "translation"]},
    "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ProgramArgs": {
      "description": "${package}, ${data} and ${cache} become the plugin's folders, and ${setting:<id>} a setting's value; never a secret, which only env may take.",
      "type": "array",
      "maxItems": 64,
      "items": {"type": "string", "maxLength": 1000}
    },
    "ProgramEnv": {
      "description": "Values take the same ${...} names as ProgramArgs, and ${setting:<id>} may name a secret.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^[A-Z_][A-Z0-9_]{0,63}$": {"type": "string", "maxLength": 1000}}
    },
    "ProgramRun": {
      "oneOf": [
        {
          "description": "Bundled in the package.",
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": {
            "path": {"description": "The program's file in the package.", "$ref": "#/$defs/FolderPath"},
            "args": {"$ref": "#/$defs/ProgramArgs"},
            "env": {"$ref": "#/$defs/ProgramEnv"}
          }
        },
        {
          "description": "Downloaded by HikariSub and checked against its SHA-256.",
          "type": "object",
          "required": ["download"],
          "additionalProperties": false,
          "properties": {
            "download": {
              "type": "object",
              "required": ["url", "sha256", "size"],
              "additionalProperties": false,
              "properties": {
                "url": {"type": "string", "maxLength": 500, "pattern": "^https://"},
                "sha256": {"description": "Of the downloaded file.", "$ref": "#/$defs/Sha256"},
                "size": {
                  "description": "Bytes of the downloaded file.",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1073741824
                },
                "archive": {"enum": ["zip", "tar.gz"]},
                "entry": {"description": "With archive: the program's file inside it.", "$ref": "#/$defs/FolderPath"}
              }
            },
            "args": {"$ref": "#/$defs/ProgramArgs"},
            "env": {"$ref": "#/$defs/ProgramEnv"}
          }
        }
      ]
    },
    "ProgramPlatforms": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^(windows|linux|macos)-(x64|arm64)$": {"$ref": "#/$defs/ProgramRun"}},
      "anyOf": [
        {"required": ["windows-x64"]},
        {"required": ["linux-x64"]},
        {"required": ["windows-arm64"]},
        {"required": ["linux-arm64"]},
        {"required": ["macos-x64"]},
        {"required": ["macos-arm64"]}
      ]
    },
    "StylesPath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*\\.sty$"
    },
    "KaraokePresetPath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*\\.ass$"
    },
    "GraphPath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*\\.json$"
    },
    "LayoutPath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*\\.json$"
    },
    "QmlPath": {"type": "string", "maxLength": 200, "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*\\.qml$"},
    "IconPath": {"type": "string", "maxLength": 200, "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*\\.(png|svg)$"},
    "ScreenshotPath": {"type": "string", "maxLength": 200, "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*\\.(png|jpg)$"},
    "Setting": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "title", "type", "default"],
          "additionalProperties": false,
          "properties": {
            "id": {"$ref": "#/$defs/LocalId"},
            "title": {"$ref": "#/$defs/Title"},
            "type": {"const": "boolean"},
