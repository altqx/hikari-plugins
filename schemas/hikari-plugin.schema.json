{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hikarisub.altqx.com/schemas/hikari-plugin.schema.json",
  "title": "HikariSub plugin manifest (hikari-plugin.json)",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "api",
    "main",
    "authors"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "description": "Reverse-DNS, lowercase, at least two parts: com.example.line-tools.",
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "description": "Semantic version 2.0.0.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "api": {
      "description": "The lowest Hikari API number the plugin needs.",
      "type": "integer",
      "minimum": 1
    },
    "main": {
      "description": "The Lua file the helper runs, relative to the package root.",
      "$ref": "#/$defs/PackagePath"
    },
    "tier": {
      "description": "restricted runs without ffi, io, os and debug; unrestricted needs the user's full trust.",
      "enum": [
        "restricted",
        "unrestricted"
      ],
      "default": "restricted"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "license": {
      "description": "An SPDX expression.",
      "type": "string",
      "maxLength": 200
    },
    "homepage": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^https://"
    },
    "publicKey": {
      "description": "The author's minisign public key, the base64 line of its .pub file. Pinned at first install.",
      "type": "string",
      "pattern": "^RW[A-Za-z0-9+/]{54}$"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documents.all": {
          "description": "Read and edit every open Document, not just the active one. The value is the reason shown to the user.",
          "$ref": "#/$defs/Reason"
        },
        "network": {
          "type": "object",
          "required": [
            "hosts",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "hosts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/Host"
              }
            },
            "reason": {
              "$ref": "#/$defs/Reason"
            }
          }
        },
        "files": {
          "description": "Folders the plugin asks the user to pick; HikariSub remembers each grant.",
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/LocalId"
              },
              "title": {
                "$ref": "#/$defs/Title"
              },
              "writable": {
                "type": "boolean",
                "default": false
              },
              "reason": {
                "$ref": "#/$defs/Reason"
              }
            }
          }
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/LocalId"
              },
              "title": {
                "$ref": "#/$defs/Title"
              }
            }
          }
        },
        "panels": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/LocalId"
              },
              "title": {
                "$ref": "#/$defs/Title"
              }
            }
          }
        },
        "settings": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/Setting"
          }
        }
      }
    },
    "summary": {
      "description": "One line for the marketplace's cards and the plugin page.",
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "icon": {
      "description": "A file in the package: a 256 × 256 px PNG or a square SVG. SVG icons follow PL1's rules, and the registry adds one of its own: no <style> element and no style attribute, only presentation attributes such as fill and stroke. Every attribute value is read as CSS after character references and CSS escapes are decoded, and is refused if it holds @import, expression( or a url( that points anywhere other than #….",
      "$ref": "#/$defs/IconPath"
    },
    "screenshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "path",
          "caption"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "#/$defs/ScreenshotPath"
          },
          "caption": {
            "description": "Shown under the image and used as its alt text.",
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
          }
        }
      }
    }
  },
  "$defs": {
    "LocalId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "Title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "Reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "Host": {
      "description": "A host name the plugin may reach over HTTPS; no scheme, port or wildcard.",
      "type": "string",
      "maxLength": 253,
      "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]([a-z0-9-]*[a-z0-9])?$"
    },
    "PackagePath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*\\.lua$"
    },
    "Setting": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "title",
            "type",
            "default"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/LocalId"
            },
            "title": {
              "$ref": "#/$defs/Title"
            },
            "type": {
              "const": "boolean"
            },
            "default": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "title",
            "type",
            "default"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/LocalId"
            },
            "title": {
              "$ref": "#/$defs/Title"
            },
            "type": {
              "const": "integer"
            },
            "default": {
              "type": "integer"
            },
            "minimum": {
              "type": "integer"
            },
            "maximum": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "title",
            "type",
            "default"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/LocalId"
            },
            "title": {
              "$ref": "#/$defs/Title"
            },
            "type": {
              "const": "number"
            },
            "default": {
              "type": "number"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "title",
            "type",
            "default"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/LocalId"
            },
            "title": {
              "$ref": "#/$defs/Title"
            },
            "type": {
              "const": "string"
            },
            "default": {
              "type": "string",
              "maxLength": 1000
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "title",
            "type",
            "options",
            "default"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/LocalId"
            },
            "title": {
              "$ref": "#/$defs/Title"
            },
            "type": {
              "const": "choice"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/Title"
              }
            },
            "default": {
              "$ref": "#/$defs/Title"
            }
          }
        }
      ]
    },
    "IconPath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*\\.(png|svg)$"
    },
    "ScreenshotPath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*\\.(png|jpg)$"
    }
  },
  "description": "PL1's manifest schema (altqx/hikari, branch w8-pl1) plus the add-only media fields proposed for the follow-up PR: summary, icon, screenshots."
}
