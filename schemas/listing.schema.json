{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketplace.hikarisub.org/schemas/listing.schema.json",
  "title": "HikariSub marketplace listing (plugins/<id>.json)",
  "description": "Each release of the listed plugin must pass PL1's package and media rules. SVG icons follow PL1's rules, and the registry adds one of its own: no <style> element and no style attribute, only presentation attributes such as fill and stroke. Every attribute value is read as CSS after character references and CSS escapes are decoded, and is refused if it holds @import, expression( or a url( that points anywhere other than #…. A refusal reads like HikariSub's: \"The package breaks the media rules: <path> <what is wrong>.\"",
  "type": "object",
  "required": ["id", "author", "repo", "publicKey", "categories"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "id": {
      "description": "The plugin's manifest id. Its first segment is the author's handle.",
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
    },
    "author": {
      "description": "The author's handle, claimed with their first accepted listing.",
      "type": "string",
      "maxLength": 39,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "authorName": {"type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
    "repo": {
      "description": "Where releases are published.",
      "type": "string",
      "pattern": "^github\\.com/[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]{1,100}$"
    },
    "publicKey": {
      "description": "The base64 line of the author's minisign .pub file.",
      "type": "string",
      "pattern": "^RW[A-Za-z0-9+/]{54}$"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["Timing", "Typesetting", "Karaoke", "Translation", "Styles and fonts", "Video and audio",
                         "Import and export", "Quality checks", "Utilities"]}
    },
    "revoked": {
      "description": "Revokes the whole plugin.",
      "$ref": "#/$defs/Revocation"
    },
    "revokedVersions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "reason"],
        "additionalProperties": false,
        "properties": {
          "version": {"type": "string", "maxLength": 64},
          "reason": {"$ref": "#/$defs/Reason"},
          "date": {"$ref": "#/$defs/Date"}
        }
      }
    }
  },
  "$defs": {
    "Reason": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
    "Date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "Revocation": {
      "type": "object",
      "required": ["reason"],
      "additionalProperties": false,
      "properties": {"reason": {"$ref": "#/$defs/Reason"}, "date": {"$ref": "#/$defs/Date"}}
    }
  }
}
